# Coordinator environment — docs/SETUP.md §12.2, FRD §22.
# Copy to server/.env and fill in. Never commit .env.

PORT=8080
AGENT_URL=http://localhost:8000

# Atlas. Contains a password — same rules as an API key.
# Leave unset ONLY when running fully faked (FAKE_AGENT=1 FAKE_RENDER=1), which
# falls back to an in-memory store so P4 can develop with no dependencies.
MONGODB_URI=mongodb+srv://clarity:<password>@clarity.xxxxx.mongodb.net/clarity
MONGODB_DB=clarity

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
RENDER_BUCKET=clarity-renders

# Defaults to NumCPU/2 when unset.
# RENDER_CONCURRENCY=4
RENDER_TIMEOUT_SEC=120

# -ql (480p, dev) or -qm (720p, release). One job-level value for every scene.
MANIM_QUALITY=-ql

# Fakes. Both default to 1 until Sprint 4, when they are deleted.
#   FAKE_AGENT=1   hardcodes P1's /vision and /explain responses
#   FAKE_RENDER=1  copies a sample MP4 instead of rendering
FAKE_AGENT=1
FAKE_RENDER=1

# The MP4 served as video_url while FAKE_RENDER is on. Put a sample in MinIO:
#   mc cp sample.mp4 local/clarity-renders/samples/sample.mp4
FAKE_VIDEO_URL=http://localhost:9000/clarity-renders/samples/sample.mp4
