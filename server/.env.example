# Coordinator environment — docs/SETUP.md §12.2, FRD §22.
# Copy to server/.env and fill in. Never commit .env.

PORT=8080
AGENT_URL=http://localhost:8000

# Atlas. Contains a password — same rules as an API key. Required.
MONGODB_URI=mongodb+srv://clarity:<password>@clarity.xxxxx.mongodb.net/clarity
MONGODB_DB=clarity

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
RENDER_BUCKET=clarity-renders

# Defaults to NumCPU/2 when unset.
# RENDER_CONCURRENCY=4
RENDER_TIMEOUT_SEC=120

# -ql (480p, dev) or -qm (720p, release). One job-level value for every scene.
# Sprint 5: release configuration is -qm. Switch back to -ql for faster local
# iteration during development.
MANIM_QUALITY=-qm
